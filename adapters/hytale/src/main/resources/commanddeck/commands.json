      "name": "No lives limit",
      "category": "Cheat Menu: Health and game mode",
      "permission": "cheatmenu.use",
      "description": "Removes your lives count, so you can't run out of lives.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/player lives clear"
          }
        ]
      }
    },
    {
      "id": "cheat-peaceful",
      "name": "Peaceful",
      "category": "Cheat Menu: World",
      "permission": "cheatmenu.use",
      "description": "World: stops new creatures from spawning. Creatures already in the world stay, and can still attack. Monsters back undoes it.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/world settings spawningnpc set false"
          }
        ]
      }
    },
    {
      "id": "cheat-monsters-back",
      "name": "Monsters back",
      "category": "Cheat Menu: World",
      "permission": "cheatmenu.use",
      "description": "World: creatures spawn as usual again.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/world settings spawningnpc reset"
          }
        ]
      }
    },
    {
      "id": "cheat-freeze-npcs",
      "name": "Freeze all creatures",
      "category": "Cheat Menu: World",
      "permission": "cheatmenu.use",
      "description": "World: every creature stops where it is. Unfreeze creatures undoes it.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/world settings freezeallnpcs set true"
          }
        ]
      }
    },
    {
      "id": "cheat-unfreeze-npcs",
      "name": "Unfreeze creatures",
      "category": "Cheat Menu: World",
      "permission": "cheatmenu.use",
      "description": "World: creatures move again.",
