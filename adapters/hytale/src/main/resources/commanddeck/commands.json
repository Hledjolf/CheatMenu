      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/gamemode adventure"
          }
        ]
      }
    },
    {
      "id": "cheat-respawn",
      "name": "Back to your bed",
      "category": "Cheat Menu: Health and game mode",
      "permission": "cheatmenu.use",
      "description": "Teleports you to your respawn point: your bed if you've set one, otherwise the world spawn. Nothing is lost.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/tp home"
          }
        ]
      }
    },
    {
