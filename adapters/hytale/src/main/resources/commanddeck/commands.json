      "id": "cheat-weather-reset",
      "name": "Normal weather",
      "category": "Cheat Menu: Time and weather",
      "permission": "cheatmenu.use",
      "description": "World: ends any forced weather, so the world's own weather comes back.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/weather reset"
          }
        ]
      }
    },
    {
      "id": "cheat-heal",
      "name": "Heal",
      "category": "Cheat Menu: Health and game mode",
      "permission": "cheatmenu.use",
      "description": "Fills your health and stamina.",
      "macro": {
        "type": "sequence",
        "steps": [
          {
            "type": "command",
            "line": "/cheatmenu check"
          },
          {
            "type": "command",
            "line": "/heal"
          }
        ]
      }
    },
    {
      "id": "cheat-creative",
      "name": "Creative mode",
